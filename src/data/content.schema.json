{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucholabs.dev/schemas/content.schema.json",
  "title": "LuchoLabs Content",
  "description": "Canonical content schema shared between the CV (lucholabs.dev) and the Lab (lucholabs.dev/lab). Edit content.json; both sites consume it.",
  "$defs": {
    "LocaleString": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "en",
            "es"
          ],
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "string"
            },
            "es": {
              "type": "string"
            }
          }
        }
      ]
    },
    "ImageObject": {
      "type": "object",
      "required": [
        "url",
        "width",
        "height",
        "caption"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "caption": {
          "type": "string"
        }
      }
    },
    "NamespacePage": {
      "type": "object",
      "required": [
        "title",
        "tagline",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/LocaleString"
        },
        "tagline": {
          "$ref": "#/$defs/LocaleString"
        },
        "body": {
          "$ref": "#/$defs/LocaleString"
        }
      }
    },
    "SeoEntry": {
      "type": "object",
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/LocaleString"
        },
        "description": {
          "$ref": "#/$defs/LocaleString"
        },
        "ogImage": {
          "type": "string"
        }
      }
    },
    "MetricBucket": {
      "type": "object",
      "required": [
        "primary",
        "secondary"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "LabCopy": {
      "type": "object",
      "properties": {
        "relatedKicker": {
          "$ref": "#/$defs/LocaleString"
        },
        "relatedLabel": {
          "$ref": "#/$defs/LocaleString"
        },
        "archiveTitle": {
          "$ref": "#/$defs/LocaleString"
        },
        "archiveDescription": {
          "$ref": "#/$defs/LocaleString"
        }
      },
      "additionalProperties": false
    },
    "LabBlock": {
      "type": "object",
      "properties": {
        "copy": {
          "$ref": "#/$defs/LabCopy"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "meta",
    "identity",
    "stats",
    "currentlyBuilding",
    "bentExperience",
    "skills",
    "thesis",
    "speaking",
    "experience",
    "projects",
    "manifesto",
    "nowNext",
    "contact",
    "contactMeta",
    "certificates",
    "talks",
    "faq",
    "urlNamespaces",
    "seo",
    "metrics"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "required": [
        "lastUpdated",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "lastUpdated": {
          "type": "string",
          "format": "date"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "name",
        "title",
        "subtitle",
        "cvUrl",
        "photo",
        "image",
        "subMark",
        "latamLine"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/LocaleString"
        },
        "subtitle": {
          "$ref": "#/$defs/LocaleString"
        },
        "roleLine": {
          "$ref": "#/$defs/LocaleString"
        },
        "cvUrl": {
          "type": "string"
        },
        "photo": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/ImageObject"
        },
        "subMark": {
          "$ref": "#/$defs/LocaleString"
        },
        "latamLine": {
          "$ref": "#/$defs/LocaleString"
        }
      }
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "sub",
          "subColor",
          "category"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "$ref": "#/$defs/LocaleString"
          },
          "sub": {
            "$ref": "#/$defs/LocaleString"
          },
          "subColor": {
            "type": "string"
          },
          "category": {
            "$ref": "#/$defs/LocaleString"
          },
          "pulse": {
            "type": "boolean"
          }
        }
      }
    },
    "currentlyBuilding": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bentExperience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "company",
          "role",
          "period"
        ],
        "additionalProperties": false,
        "properties": {
          "company": {
            "type": "string"
          },
          "role": {
            "$ref": "#/$defs/LocaleString"
          },
          "period": {
            "$ref": "#/$defs/LocaleString"
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "required": [
        "core",
        "tooling"
      ],
      "additionalProperties": false,
      "properties": {
        "core": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocaleString"
          }
        },
        "tooling": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocaleString"
          }
        }
      }
    },
    "thesis": {
      "type": "object",
      "required": [
        "title",
        "subtitle",
        "institution",
        "status",
        "adoptedBy",
        "stack",
        "impact"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/LocaleString"
        },
        "subtitle": {
          "$ref": "#/$defs/LocaleString"
        },
        "institution": {
          "$ref": "#/$defs/LocaleString"
        },
        "status": {
          "$ref": "#/$defs/LocaleString"
        },
        "adoptedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impact": {
          "$ref": "#/$defs/LocaleString"
        },
        "publicationUrl": {
          "type": "string"
        },
        "repoUrl": {
          "type": "string"
        }
      }
    },
    "speaking": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "status",
          "event",
          "location",
          "date",
          "topic"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "past",
              "upcoming"
            ]
          },
          "event": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "topic": {
            "$ref": "#/$defs/LocaleString"
          },
          "photo": {
            "type": "string"
          },
          "recapUrl": {
            "type": "string",
            "description": "Reserved for talk-page links (Phase 0.5C)."
          },
          "videoUrl": {
            "type": "string",
            "description": "Reserved for YouTube embed (Phase 0.5E)."
          },
          "slidesUrl": {
            "type": "string"
          }
        }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "company",
          "role",
          "period",
          "description",
          "tags"
        ],
        "additionalProperties": false,
        "properties": {
          "company": {
            "type": "string"
          },
          "role": {
            "$ref": "#/$defs/LocaleString"
          },
          "period": {
            "$ref": "#/$defs/LocaleString"
          },
          "description": {
            "$ref": "#/$defs/LocaleString"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/LocaleString"
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "slug",
          "tagline",
          "description",
          "stack",
          "status",
          "statusColor",
          "featuredOnCv",
          "featuredOnLab",
          "isHeadline",
          "isArchived",
          "isKilled",
          "cvTagline",
          "cvDescription",
          "labTagline",
          "labDescription",
          "labQuote",
          "labFeatures",
          "labVision",
          "links",
          "repoUrl"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "tagline": {
            "$ref": "#/$defs/LocaleString"
          },
          "description": {
            "$ref": "#/$defs/LocaleString"
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "$ref": "#/$defs/LocaleString"
          },
          "statusColor": {
            "type": "string"
          },
          "featuredOnCv": {
            "type": "boolean"
          },
          "featuredOnLab": {
            "type": "boolean"
          },
          "isHeadline": {
            "type": "boolean"
          },
          "isArchived": {
            "type": "boolean"
          },
          "isKilled": {
            "type": "boolean"
          },
          "cvTagline": {
            "$ref": "#/$defs/LocaleString"
          },
          "cvDescription": {
            "$ref": "#/$defs/LocaleString"
          },
          "labTagline": {
            "$ref": "#/$defs/LocaleString"
          },
          "labDescription": {
            "$ref": "#/$defs/LocaleString"
          },
          "labQuote": {
            "$ref": "#/$defs/LocaleString"
          },
          "labFeatures": {
            "oneOf": [
              {
                "const": []
              },
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "$ref": "#/$defs/LocaleString"
                }
              }
            ]
          },
          "labVision": {
            "$ref": "#/$defs/LocaleString"
          },
          "links": {
            "type": "object",
            "required": [
              "github",
              "demo",
              "paper"
            ],
            "additionalProperties": false,
            "properties": {
              "github": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "demo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "paper": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "repoUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "demoUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "manifesto": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "body",
          "citationProjectSlug"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "$ref": "#/$defs/LocaleString"
          },
          "body": {
            "$ref": "#/$defs/LocaleString"
          },
          "citationProjectSlug": {
            "type": "string"
          }
        }
      }
    },
    "nowNext": {
      "type": "object",
      "required": [
        "now",
        "next",
        "recentCommits"
      ],
      "additionalProperties": false,
      "properties": {
        "now": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocaleString"
          }
        },
        "next": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocaleString"
          }
        },
        "recentCommits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "now": {
      "type": "object",
      "required": [
        "updated",
        "intro",
        "focus",
        "next"
      ],
      "additionalProperties": false,
      "properties": {
        "updated": {
          "type": "string",
          "format": "date"
        },
        "intro": {
          "$ref": "#/$defs/LocaleString"
        },
        "focus": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocaleString"
          }
        },
        "next": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LocaleString"
          }
        }
      }
    },
    "uses": {
      "type": "object",
      "required": [
        "intro",
        "categories"
      ],
      "additionalProperties": false,
      "properties": {
        "intro": {
          "$ref": "#/$defs/LocaleString"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "$ref": "#/$defs/LocaleString"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "note"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "note": {
                      "$ref": "#/$defs/LocaleString"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "printCv": {
      "type": "object",
      "required": [
        "summary"
      ],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "$ref": "#/$defs/LocaleString"
        }
      }
    },
    "contact": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        }
      }
    },
    "contactMeta": {
      "type": "object",
      "required": [
        "availability",
        "cta",
        "notForLine"
      ],
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/LocaleString"
        },
        "cta": {
          "$ref": "#/$defs/LocaleString"
        },
        "calUrl": {
          "type": "string"
        },
        "hireHeadline": {
          "$ref": "#/$defs/LocaleString"
        },
        "speakingHeadline": {
          "$ref": "#/$defs/LocaleString"
        },
        "speakingCta": {
          "$ref": "#/$defs/LocaleString"
        },
        "freelanceLine": {
          "$ref": "#/$defs/LocaleString"
        },
        "notForLine": {
          "$ref": "#/$defs/LocaleString"
        }
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "issuer",
          "date",
          "topics",
          "credentialUrl"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "$ref": "#/$defs/LocaleString"
          },
          "issuer": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/LocaleString"
            }
          },
          "credentialUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "talks": {
      "type": "array",
      "description": "Dedicated long-form pages for individual speaking appearances (consumed by /talks/:slug route).",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "event",
          "location",
          "date",
          "title",
          "abstract",
          "keyTakeaways"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "event": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Human-readable, e.g. 'May 2026'."
          },
          "absoluteDate": {
            "type": "string",
            "description": "ISO date (YYYY-MM-DD) for sorting and structured data."
          },
          "title": {
            "$ref": "#/$defs/LocaleString"
          },
          "subtitle": {
            "$ref": "#/$defs/LocaleString"
          },
          "format": {
            "$ref": "#/$defs/LocaleString"
          },
          "role": {
            "$ref": "#/$defs/LocaleString"
          },
          "abstract": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/LocaleString"
            },
            "description": "Paragraphs of long-form description."
          },
          "heroPhoto": {
            "type": "string"
          },
          "heroPhotoAlt": {
            "$ref": "#/$defs/LocaleString"
          },
          "videoUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "YouTube/Vimeo embed URL when available."
          },
          "slidesUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "keyTakeaways": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/LocaleString"
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            }
          },
          "gallery": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "src",
                "alt"
              ],
              "additionalProperties": false,
              "properties": {
                "src": {
                  "type": "string"
                },
                "alt": {
                  "$ref": "#/$defs/LocaleString"
                }
              }
            }
          },
          "relatedBlogSlug": {
            "type": [
              "string",
              "null"
            ]
          },
          "labAnchorUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "question",
          "answer"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "$ref": "#/$defs/LocaleString"
          },
          "answer": {
            "$ref": "#/$defs/LocaleString"
          }
        }
      }
    },
    "urlNamespaces": {
      "type": "object",
      "required": [
        "services",
        "case-studies",
        "print"
      ],
      "additionalProperties": false,
      "properties": {
        "services": {
          "$ref": "#/$defs/NamespacePage"
        },
        "case-studies": {
          "$ref": "#/$defs/NamespacePage"
        },
        "print": {
          "$ref": "#/$defs/NamespacePage"
        }
      }
    },
    "servicesPage": {
      "type": "object",
      "required": [
        "published",
        "slots"
      ],
      "additionalProperties": false,
      "properties": {
        "published": {
          "type": "boolean"
        },
        "slots": {
          "type": "object",
          "required": [
            "heading",
            "offers"
          ],
          "additionalProperties": false,
          "properties": {
            "heading": {
              "$ref": "#/$defs/LocaleString"
            },
            "offers": {
              "type": "array"
            },
            "intro": {
              "$ref": "#/$defs/LocaleString"
            },
            "sections": {
              "type": "array"
            },
            "faq": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "question",
                  "answer"
                ],
                "additionalProperties": false,
                "properties": {
                  "question": {
                    "$ref": "#/$defs/LocaleString"
                  },
                  "answer": {
                    "$ref": "#/$defs/LocaleString"
                  }
                }
              }
            }
          }
        }
      }
    },
    "caseStudiesPage": {
      "type": "object",
      "required": [
        "published",
        "entries"
      ],
      "additionalProperties": false,
      "properties": {
        "published": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slug",
              "published",
              "title",
              "sections"
            ],
            "additionalProperties": false,
            "properties": {
              "slug": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "published": {
                "type": "boolean"
              },
              "title": {
                "$ref": "#/$defs/LocaleString"
              },
              "sections": {
                "type": "array"
              },
              "summary": {
                "$ref": "#/$defs/LocaleString"
              },
              "faq": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "question",
                    "answer"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "question": {
                      "$ref": "#/$defs/LocaleString"
                    },
                    "answer": {
                      "$ref": "#/$defs/LocaleString"
                    }
                  }
                }
              }
            }
          }
        },
        "heading": {
          "$ref": "#/$defs/LocaleString"
        },
        "intro": {
          "$ref": "#/$defs/LocaleString"
        },
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "question",
              "answer"
            ],
            "additionalProperties": false,
